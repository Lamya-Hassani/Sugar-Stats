        :root {
            --c-bg: #FFF5F7;
            /* Pale Blush */
            --c-text: #5D4037;
            /* Truffle Brown */
            --c-accent: #D48C9D;
            /* Dusty Rose */
            --c-white: #FFFFFF;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lato', sans-serif;
            background-color: var(--c-bg);
            /* Pink Background */
            color: var(--c-text);
            font-size: 16px;
            line-height: 1.3;
            overflow-x: hidden;
        }

        /* --- CANVAS --- */
        canvas {
            position: fixed;
            top: 0;
            left: 0;
            z-index: -1;
            width: 100%;
            height: 100%;
        }

        /* --- TYPOGRAPHY --- */
        a {
            text-decoration: none;
            color: var(--c-text);
            transition: 0.3s;
        }

        a:hover {
            color: var(--c-accent);
        }

        ul {
            list-style: none;
        }

        h1,
        h2,
        h5 {
            font-family: 'Playfair Display', serif;
        }

        /* --- MOUSE EFFECT --- */
        .mouse-effect {
            opacity: 0;
            position: fixed;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 1000;
        }

        .circle {
            position: absolute;
            background-color: var(--c-accent);
            width: 10px;
            height: 10px;
            border-radius: 100%;
            transform: translate(-50%, -50%);
        }

        .circle-follow {
            position: absolute;
            border: 1px solid var(--c-text);
            width: 40px;
            height: 40px;
            border-radius: 100%;
            transform: translate(-50%, -50%);
            transition: all 0.1s;
        }

        /* --- LOADING TEXT (The Big Title) --- */
        .main-txt {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: fit-content;
            text-transform: uppercase;
            font-family: 'Playfair Display', serif;
            font-size: clamp(3rem, 8vw, 100px);
            letter-spacing: -2px;
            z-index: -1;
            color: var(--c-text);
            transition: opacity 0.5s ease-in-out;
        }

        /* --- VISIBILITY TOGGLE --- */
        .hide-text {
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }

        /* --- HEADER / NAV --- */
        header {
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 10;
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 3rem;
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            text-transform: none;
            /* Keep it elegant */
        }

        .navbar-brand span {
            color: var(--c-accent);
            font-style: italic;
        }

        nav ul {
            display: flex;
            gap: 3rem;
        }

        nav ul a {
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            position: relative;
        }

        nav ul a::after {
            content: "";
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--c-accent);
            transition: 0.5s;
        }

        nav ul a:hover::after {
            width: 100%;
        }

        .ham-btn {
            background: transparent;
            border: none;
            font-size: 1.5rem;
            color: var(--c-text);
            cursor: pointer;
        }

        /* --- HERO BANNER LAYOUT --- */
        .banner-inner {
            padding: 120px 3rem 40px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Top Corner Info */
        .top-desc h5 {
            font-size: 1.2rem;
            margin-bottom: 5px;
        }

        .top-desc h6 {
            font-size: 0.9rem;
            font-family: 'Lato', sans-serif;
            opacity: 0.7;
            margin-bottom: 10px;
        }

        .top-desc span {
            display: block;
            width: 30px;
            height: 2px;
            background: var(--c-accent);
        }

        /* Bottom Section */
        .bottom-desc {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        /* Left Bottom */
        .left-desc h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--c-accent);
        }

        .desc-inner h5 {
            font-size: 1.2rem;
            margin-bottom: 5px;
        }

        .desc-inner h6 {
            font-size: 0.9rem;
