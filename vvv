            font-size: clamp(2rem, 5vw, 4rem);
            text-align: center;
            line-height: 1;
        }

        .middle-desc h2 i {
            color: var(--c-accent);
        }

        /* Right Bottom (Socials) */
        .right-desc {
            text-align: right;
        }

        .right-desc h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
            font-family: 'Playfair Display', serif;
        }

        .right-desc h1::after {
            content: "";
            position: absolute;
            top: 50%;
            right: -50px;
            width: 40px;
            height: 2px;
            background: var(--c-text);
        }

        .right-desc .desc-inner {
            display: flex;
            align-items: center;
            gap: 20px;
            justify-content: flex-end;
        }

        .right-desc span {
            text-transform: uppercase;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .right-desc ul {
            display: flex;
            gap: 15px;
        }

        .right-desc i {
            font-size: 1.2rem;
            transition: 0.3s;
        }

        .right-desc i:hover {
            color: var(--c-accent);
            transform: translateY(-3px);
        }

        /* --- ROTATED SIDE TEXT --- */
        .rotated-text {
            position: fixed;
            top: 50%;
            right: 40px;
            transform: translateY(-50%) rotate(90deg);
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 2px;
            font-weight: 700;
            color: var(--c-accent);
        }

        /* Mobile Adjustments */
        @media (max-width: 900px) {
            .header-inner {
                padding: 1.5rem;
            }

            nav ul {
                display: none;
            }

            .banner-inner {
                padding: 100px 1.5rem 30px;
            }

            .bottom-desc {
                flex-direction: column;
                align-items: flex-start;
                gap: 2rem;
            }

            .middle-desc {
                order: -1;
                margin-bottom: 2rem;
            }

            .right-desc {
                align-self: flex-start;
                text-align: left;
            }

            .right-desc h1::after {
                right: auto;
                left: 50px;
            }

            .rotated-text {
                display: none;
            }
        }
    </style>
</head>

